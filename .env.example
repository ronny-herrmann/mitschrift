# Mitschrift – Konfiguration (Kopie als .env speichern)

# --- Spracherkennung -----------------------------------------------------
# parakeet  = NVIDIA Parakeet TDT 0.6B v3, int8, sehr schnell auf CPU (Empfehlung für den Pilot)
# whisper   = whisper-large-v3-turbo-german (faster-whisper), genauer bei Fachvokabular, langsamer auf CPU
# fake      = kein Modell (nur für Tests der Oberfläche)
ASR_BACKEND=parakeet
LANGUAGE=de
DEVICE=cpu            # cpu | cuda
ASR_WORKERS=1         # parallele Modellaufrufe (CPU: 1–2, GPU: 2–4)

PARAKEET_MODEL=nemo-parakeet-tdt-0.6b-v3
PARAKEET_QUANTIZATION=int8       # int8 (CPU) oder leer für volle Genauigkeit (GPU)

WHISPER_MODEL=cstr/whisper-large-v3-turbo-german-int8_float32
WHISPER_COMPUTE_TYPE=int8        # int8 (CPU) | float16 (GPU)
WHISPER_BEAM_SIZE=1              # 1 = schnell, 5 = etwas genauer, deutlich langsamer

# --- Live-Segmentierung ----------------------------------------------------
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=700           # Pause, nach der ein Satz als fertig gilt
VAD_MAX_SEGMENT_S=15
LIVE_FINAL_PASS=1                # nach Stopp zweiter Durchlauf über die ganze Aufnahme

# --- Protokoll-KI (optional; OpenAI-kompatibel) ----------------------------
# Beispiele: Ollama lokal  → LLM_BASE_URL=http://ollama:11434/v1  LLM_MODEL=qwen3:14b
#            NOVA/BotBucket → sobald eine eingehende API bekannt ist (Frage an YOUniquehorns)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=300

# --- Speicherung / Löschfristen ---------------------------------------------
DATA_DIR=./data
MODELS_DIR=./models
RETENTION_AUDIO_DAYS=0           # z. B. 30 = Audio nach 30 Tagen automatisch löschen (0 = behalten)
RETENTION_TRANSCRIPT_DAYS=0

# --- Zugriff (Pilot) -----------------------------------------------------------
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- HTTPS (docker-compose mit Caddy) ------------------------------------------
MITSCHRIFT_HOST=localhost        # Hostname, unter dem die Oberfläche erreichbar ist
