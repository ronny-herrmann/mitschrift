# Mitschrift – Konfiguration (Kopie als .env speichern)

# --- Spracherkennung -----------------------------------------------------
# parakeet = NVIDIA Parakeet TDT 0.6B v3 (int8, sherpa-onnx) – schnell, Standard für live
# whisper  = whisper-large-v3-turbo-german (faster-whisper) – genauer bei Fachvokabular, langsamer
# fake     = kein Modell (nur Oberflächentest)
ASR_BACKEND=parakeet
# Genaues Modell für Uploads + Verfeinerung nach Live-Aufnahme (leer = gleiches Modell)
FINAL_ASR_BACKEND=
LANGUAGE=de
DEVICE=cpu
ASR_WORKERS=1

WHISPER_MODEL=cstr/whisper-large-v3-turbo-german-int8_float32
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1

# --- Segmentierung ----------------------------------------------------------
VAD_THRESHOLD=0.5
VAD_MIN_SILENCE_MS=550           # Pause, nach der ein Satz als fertig gilt (schwarz)
VAD_MAX_SEGMENT_S=12
LIVE_PARTIALS=1                  # grauer Zwischentext während des Sprechens
LIVE_PARTIAL_INTERVAL_S=1.0
LIVE_AI_CLEAN=1                  # jeden fertigen Satz live von der KI bereinigen (nur mit LLM_*)
OFFLINE_MAX_SEGMENT_S=28
OFFLINE_MIN_SILENCE_MS=1200
LIVE_FINAL_PASS=1

# --- Sprechererkennung (im Hintergrund nach der Aufnahme) --------------------
DIARIZATION=1
DIARIZATION_THRESHOLD=0.7        # kleiner = mehr Sprecher, größer = weniger
DIARIZATION_SPEAKERS=0           # feste Anzahl, falls bekannt (0 = automatisch)

# --- KI für Bereinigung & Zusammenfassung (optional, OpenAI-kompatibel) ------------
# Ohne Eintrag funktionieren beide Knöpfe über NOVA (Kopieren → Einfügen → Prüfen).
# Beispiele: IONOS AI Model Hub (DE):  LLM_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
#            Ollama lokal (GPU nötig):  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:14b
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=300

# --- Speicherung / Datensparsamkeit ----------------------------------------------
DATA_DIR=./data
MODELS_DIR=./models
AUDIO_DELETE_AFTER_DONE=0
RETENTION_AUDIO_HOURS=0
RETENTION_TRANSCRIPT_HOURS=0

# --- Zugriff (auf einem Server PFLICHT) ---------------------------------------------
ACCESS_PASSWORD=
SESSION_SECRET=
SESSION_HOURS=12
COOKIE_SECURE=0

# --- HTTPS (docker-compose mit Caddy) ------------------------------------------------
MITSCHRIFT_HOST=localhost
