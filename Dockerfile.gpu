# GPU-Image (Stufe 2, ungetestet): CUDA 12 + cuDNN 9 für onnxruntime-gpu und CTranslate2
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ffmpeg && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN sed -i 's/^onnxruntime>=/onnxruntime-gpu>=/' requirements.txt && pip3 install --no-cache-dir -r requirements.txt

COPY app ./app
COPY bench ./bench
COPY scripts ./scripts

ENV DATA_DIR=/data MODELS_DIR=/models MITSCHRIFT_ENV_FILE=/app/.env PYTHONUNBUFFERED=1 DEVICE=cuda
VOLUME ["/data", "/models"]
EXPOSE 8000
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
